APP_ENV=development
APP_NAME=naha-superapp
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_GRAPH_VERSION=v23.0
INTERNAL_WEBHOOK_SECRET=replace-me
WEBHOOK_MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60

# Lesotho payment providers (configure only providers contracted for production)
MOPAY_BASE_URL=
MOPAY_API_KEY=
MOPAY_WEBHOOK_SECRET=
PAYLESOTHO_BASE_URL=
PAYLESOTHO_API_KEY=
PAYLESOTHO_WEBHOOK_SECRET=
MPESA_LS_BASE_URL=
MPESA_LS_API_KEY=
MPESA_LS_WEBHOOK_SECRET=
ECOCASH_LS_BASE_URL=
ECOCASH_LS_API_KEY=
ECOCASH_LS_WEBHOOK_SECRET=
KHETSI_BASE_URL=
KHETSI_API_KEY=
KHETSI_WEBHOOK_SECRET=
CPAY_BASE_URL=
CPAY_API_KEY=
CPAY_WEBHOOK_SECRET=
SMARTEL_BASE_URL=
SMARTEL_API_KEY=
SMARTEL_WEBHOOK_SECRET=
CHAPERONE_BASE_URL=
CHAPERONE_API_KEY=
CHAPERONE_WEBHOOK_SECRET=
# v1.3 payment orchestration
MOPAY_BASE_URL=https://mopay.co.ls
MOPAY_API_KEY=

# v2.0 Baileys operator
OPERATOR_URL=http://localhost:3001
OPERATOR_API_KEY=replace-me
WEBHOOK_SECRET=replace-me
MAIN_APP_WEBHOOK_URL=http://localhost:8000/webhooks/whatsapp/baileys
IDENTITY_PEPPER=replace-me-long-random-secret
IDENTITY_SESSION_TTL_MINUTES=60
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# v2.3 WhatsApp media
MEDIA_STORAGE_BACKEND=supabase
MEDIA_BUCKET=whatsapp-media
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_LOCAL_ROOT=/tmp/naha-media

MEDIA_ANTIVIRUS_BACKEND=clamav
MEDIA_ANTIVIRUS_FAIL_CLOSED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

INTELLIGENCE_AUTO_REPLY=false
# WhatsApp transport: baileys now; meta_cloud reserved for future official Meta migration
WHATSAPP_TRANSPORT=baileys
